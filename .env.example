# Copy to .env and fill in. Never commit .env.

# One deployment is one household. Each account can map several Wilma profiles,
# and the same child name may appear under several accounts.
# Keep this JSON on one line in .env.
WILMA_ACCOUNTS_JSON=[{"id":"koulu-a","baseUrl":"https://esimerkki.inschool.fi","username":"huoltaja","password":"vaihda-tama","profiles":[{"studentNumber":"12345","child":"Aino"}]}]

# Server-side only. The Sonnet model is a code constant in src/analysis.ts.
ANTHROPIC_API_KEY=

# Google OAuth web application credentials. Register this exact callback URL in
# Google Cloud: ${APP_BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_ALLOWED_EMAIL=you@example.com

# Public URL as seen by the browser. Use the HTTPS URL of your reverse proxy in
# production. Google OAuth redirect URIs must match this value.
APP_BASE_URL=http://localhost:3000
PORT=3000
# Host-side loopback port published by Docker Compose.
HOST_PORT=3000

# SQLite analysis cache and Google OAuth token live here. Wilma message bodies
# are not archived.
DATA_DIR=./data
