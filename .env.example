# Copy to .env and fill in. Never commit .env.

# One deployment is one household. Every student profile available to an account
# is discovered automatically. Optional profiles entries can override child names.
# Keep this JSON on one line in .env.
WILMA_ACCOUNTS_JSON=[{"id":"koulu-a","baseUrl":"https://esimerkki.inschool.fi","username":"huoltaja","password":"vaihda-tama"}]

# Optional class-page module shown as Einari's latest homework card. Keep both
# values in the untracked .env; do not commit a household's page identity.
PEDANET_HOMEWORK_URL=
PEDANET_HOMEWORK_MODULE_ID=

# Use ANALYSIS_MODE=manual for a private local queue consumed by an operator or
# coding agent. ANTHROPIC_API_KEY is required only in the default anthropic mode.
ANALYSIS_MODE=anthropic
# Server-side only. The Sonnet model is a code constant in src/analysis.ts.
ANTHROPIC_API_KEY=

# Google OAuth web application credentials. Register this exact callback URL in
# Google Cloud: ${APP_BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Calendar owner. Only this account grants and stores Calendar credentials.
GOOGLE_ALLOWED_EMAIL=you@example.com
# Comma-separated household members allowed to sign in. Must include the owner.
# Every additional member receives read-only access to all managed calendars.
GOOGLE_ALLOWED_LOGIN_EMAILS=you@example.com

# Optional privacy-filtered server-side error reporting. Performance tracing and
# automatic request/user capture are disabled.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Set this to the deployed git SHA if your deployment automation provides it.
SENTRY_RELEASE=

# Public URL as seen by the browser. Use the HTTPS URL of your reverse proxy in
# production. Google OAuth redirect URIs must match this value.
APP_BASE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Host-side loopback port published by Docker Compose.
HOST_PORT=3000

# SQLite analysis cache, durable homework snapshot, and Google OAuth token live
# here. Wilma message bodies are not archived.
DATA_DIR=./data
