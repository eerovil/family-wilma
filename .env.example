# Copy to .env and fill in. Never commit .env — it holds Wilma passwords.

# ---------------------------------------------------------------------------
# Wilma accounts
# ---------------------------------------------------------------------------
# One set of WILMA_<N>_* variables per login. A login is an account, not a
# child: one account can expose several students, and one child can appear
# under more than one account. See docs/domain.md.
#
# Add WILMA_2_*, WILMA_3_* and so on for further accounts.

WILMA_1_BASE_URL=https://esimerkki.inschool.fi
WILMA_1_USERNAME=
WILMA_1_PASSWORD=

# ---------------------------------------------------------------------------
# Student-to-child mapping
# ---------------------------------------------------------------------------
# Which students belong to which child in this household. Student numbers come
# from the Wilma account itself, so fill these in after the first login.
#
# Format: <account>:<studentNumber>=<child name>, comma-separated. The same
# child name may appear more than once — that is the point.
#
# Whether this stays in the environment or moves into the database is still
# open; see docs/open-questions.md.

# CHILD_MAPPING=1:12345=Aino,1:12346=Eero,2:67890=Aino

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# Used server-side only. This key must never reach the browser.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Google Calendar
# ---------------------------------------------------------------------------
# OAuth credentials for the household's own Google account. The redirect URI
# must match what is registered in the Google Cloud console.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Which calendar the dated items are written to. "primary" is the account's
# own calendar; a calendar ID works too. Whether one calendar or one per child
# is right is still open; see docs/open-questions.md.
GOOGLE_CALENDAR_ID=primary

# ---------------------------------------------------------------------------
# Local
# ---------------------------------------------------------------------------
# The SQLite file holding the analysis cache. This is the only thing written
# to disk; see docs/llm-cache.md.
DATABASE_PATH=./data/family-wilma.db

# The app has no authentication of its own. Bind it to localhost or a private
# network, or put it behind something that does. See docs/security.md.
PORT=3000
HOST=127.0.0.1
