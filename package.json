{
  "name": "family-wilma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted family Wilma aggregator: one combined message view and Google Calendar sync for one household",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "manual-analysis": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs src/manual-analysis-cli.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@googleapis/calendar": "^19.0.0",
    "@sentry/node": "^10.74.0",
    "@wilm-ai/wilma-client": "^1.5.2",
    "cheerio": "^1.2.0",
    "google-auth-library": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
